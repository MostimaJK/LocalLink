{
  "name": "orbit-beta",
  "version": "1.0.0",
  "description": "LocalLink device-to-device file transfer",
  "author": "LocalLink contributors",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder --win --mac --linux --publish never",
    "test": "playwright test",
    "test:sharded": "playwright test --shard=1/2 && playwright test --shard=2/2",
    "build:win:local": "node scripts/build-windows-local.cjs",
    "test:transfers": "node tests/localsend-protocol.test.js && node tests/localsend-tasks.test.js",
    "build:win:installer": "node scripts/build-installer.cjs",
    "build:win:portable": "node scripts/build-installer.cjs --portable"
  },
  "keywords": [],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "archiver": "8.0.0",
    "bad-words": "^4.0.0",
    "better-sqlite3": "13.2.0",
    "electron-store": "^8.2.0",
    "emoji-picker-element": "^1.29.1",
    "jsqr": "^1.4.0",
    "lucide": "^1.17.0",
    "qrcode-generator": "^2.0.4",
    "selfsigned": "5.5.0",
    "sharp": "0.35.5",
    "uuid": "^14.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "^1.62.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "productName": "LocalLink",
  "overrides": {
    "minimatch": "11.0.1"
  }
}
